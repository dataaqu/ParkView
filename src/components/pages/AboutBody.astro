---
import PageHero from '../sections/PageHero.astro';
import StatementSection from '../sections/StatementSection.astro';
import ApproachSection from '../sections/ApproachSection.astro';
import WhyGrid from '../sections/WhyGrid.astro';
import DistrictSection from '../sections/DistrictSection.astro';
import PlanSection from '../sections/PlanSection.astro';
import { t } from '../../content';
import { SHOW } from '../../config/sections';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const copy = t(locale);
const about = copy.about;
const show = SHOW.about;

/* Site map, 14 Sep: Galaxy Enterprises (who we are) → Our approach → Why
   PARK VIEW (the vision) → "Discover the project" (the closing band, picked by
   route in BaseLayout). District and drawing are shown on The Project page and
   switched off here in config/sections.ts. */
---

<PageHero eyebrow={about.intro.eyebrow} title={copy.nav.about} image="/images/hero1-1920.webp" />

<StatementSection
  locale={locale}
  eyebrow={about.intro.eyebrow}
  title={about.intro.title}
  body={about.intro.body}
/>

{show.approach && <ApproachSection eyebrow={about.approach.eyebrow} title={about.approach.title} items={about.approach.items} />}

<WhyGrid
  eyebrow={about.why.eyebrow}
  title={about.why.title}
  body={about.why.body}
  features={show.whyFeatures ? about.why.features : undefined}
  assurances={about.why.assurances}
/>

{show.district && <DistrictSection eyebrow={about.district.eyebrow} title={about.district.title} body={about.district.body} />}

{
  show.plan && (
    <PlanSection eyebrow={about.plan.eyebrow} title={about.plan.title} body={about.plan.body} caption={about.plan.caption} />
  )
}
