---
import Hero from '../Hero.astro';
import DeveloperStrip from '../sections/DeveloperStrip.astro';
import ProjectsSection from '../sections/ProjectsSection.astro';
import AboutSection from '../sections/AboutSection.astro';
import WhyGrid from '../sections/WhyGrid.astro';
import GridSection from '../sections/GridSection.astro';
import { t } from '../../content';
import { INFRA_IMAGES } from '../../config/site';
import { SHOW } from '../../config/sections';
import type { Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const home = copy.home;
const show = SHOW.home;

/* Site map, 14 Sep: the homepage is the hero with its main message and two
   buttons — "Explore the project" and "Contact us". The bands below are kept,
   switched off in config/sections.ts, not deleted. */
const readMore = copy.common.readMore;
const aboutHref = localizedPath(locale, 'about');
const projectHref = localizedPath(locale, 'project');

const infraItems = home.infrastructure.items.map((item, i) => ({
  ...item,
  image: INFRA_IMAGES[i] ?? INFRA_IMAGES[INFRA_IMAGES.length - 1],
}));
---

<Hero locale={locale} />

{/* Hero → projects → footer (client, 14 Sep). */}
<ProjectsSection locale={locale} />

{show.developerStrip && <DeveloperStrip locale={locale} />}

{
  show.about && (
    <AboutSection
      locale={locale}
      eyebrow={home.about.eyebrow}
      title={home.about.title}
      body={home.about.body}
      cta={home.about.cta}
    />
  )
}

{
  show.why && (
    <WhyGrid
      eyebrow={copy.about.why.eyebrow}
      title={copy.about.why.title}
      body={copy.about.why.body}
      features={copy.about.why.features}
      cta={readMore}
      ctaHref={aboutHref}
    />
  )
}

{
  show.infrastructure && (
    <GridSection
      eyebrow={home.infrastructure.eyebrow}
      title={home.infrastructure.title}
      items={infraItems}
      cta={readMore}
      ctaHref={projectHref}
    />
  )
}

{
  show.privileges && (
    <GridSection
      eyebrow={home.privileges.eyebrow}
      title={home.privileges.title}
      items={home.privileges.items}
      tone="surface-2"
    />
  )
}
