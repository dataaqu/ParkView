---
import Icon, { type IconName } from './Icon.astro';
import { SOCIAL } from '../config/site';

interface Props {
  class?: string;
  /** `md` on the contact page, `sm` in the footer's column of small type. */
  size?: 'sm' | 'md';
  /** The footer animates nothing else, so three tiles lifting in on their own
      would read as a glitch rather than as a reveal. */
  reveal?: boolean;
  /** `dark` for the closing band, where the tiles sit on a photograph. */
  tone?: 'light' | 'dark';
}

const { class: className = '', size = 'md', reveal = true, tone = 'light' }: Props = Astro.props;

const colours =
  tone === 'dark'
    ? 'border-white/25 text-white hover:border-gold-500 hover:bg-gold-500 hover:text-white'
    : 'border-line text-ink hover:border-gold-500 hover:bg-gold-500 hover:text-white';

const tile = size === 'sm' ? 'h-11 w-11' : 'h-14 w-14';
const glyph = size === 'sm' ? 'h-5 w-5' : 'h-6 w-6';
const gap = size === 'sm' ? 'gap-2.5' : 'gap-3';
---

{/* Hairline tiles that fill gold on hover — the same border, the same gold and
    the same slow easing the rest of the site uses, so the marks read as part
    of the page rather than as a plugin dropped into it. The platform names are
    screen-reader only: they are recognisable as marks, and spelling them out
    would put three foreign wordmarks into a Georgian column. */}
<ul class:list={['flex flex-wrap', gap, className]}>
  {
    SOCIAL.map((item, i) => (
      <li {...reveal ? { 'data-reveal': true, 'data-reveal-delay': 0.06 * i } : {}}>
        <a
          href={item.href}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'flex items-center justify-center border transition-[color,background-color,border-color] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]',
            colours,
            tile,
          ]}
        >
          <Icon name={item.icon as IconName} class={glyph} />
          <span class="sr-only">{item.name}</span>
        </a>
      </li>
    ))
  }
</ul>
