---
import Icon, { type IconName } from './Icon.astro';

interface Item {
  icon: string;
  title: string;
  body: string;
  /** Path without the width suffix, e.g. `/images/infra-gate`. Optional: the
      privileges grid has no photography, and inventing some for it would put
      three facades behind three tax and residency claims. */
  image?: string;
}

interface Props {
  items: Item[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<ul class:list={['grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2 lg:grid-cols-3', className]}>
  {
    items.map((item, i) => (
      <li
        class="group relative flex flex-col bg-surface p-7 transition-colors duration-500 hover:bg-surface-2 sm:p-9 lg:p-11"
        data-reveal
        data-reveal-delay={i * 0.09}
      >
        {/* Bled to the card's edges rather than inset in it — the hairline
            grid is the frame, and a second one inside it reads as a stamp. */}
        {item.image && (
          <div class="relative -mx-7 -mt-7 mb-8 aspect-4/3 shrink-0 overflow-hidden border-b border-line sm:-mx-9 sm:-mt-9 sm:mb-9 lg:-mx-11 lg:-mt-11">
            <img
              src={`${item.image}-800.webp`}
              srcset={`${item.image}-800.webp 800w, ${item.image}-1400.webp 1400w`}
              sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 100vw"
              alt=""
              width="1400"
              height="1050"
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.04]"
            />
          </div>
        )}

        <Icon
          name={item.icon as IconName}
          class="h-10 w-10 text-gold-500 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-1"
        />

        <h3 class="mt-7 font-display text-xl leading-snug text-ink">{item.title}</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>

        {/* Gold rule that draws in on hover. */}
        <span
          class="mt-auto block h-px w-10 origin-left scale-x-100 bg-gold-500/40 pt-0 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:w-20 group-hover:bg-gold-500"
          aria-hidden="true"
          style="margin-top:2.5rem"
        />
      </li>
    ))
  }
</ul>
