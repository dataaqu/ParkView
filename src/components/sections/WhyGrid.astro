---
import Icon, { type IconName } from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import Button from '../Button.astro';

interface Feature {
  icon: string;
  title: string;
  body: string;
}

interface Assurance {
  icon: string;
  title: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  features: Feature[];
  /** Omitted on the homepage: the three one-word assurances are the end of
      the argument, and the homepage band is only its opening. */
  assurances?: Assurance[];
  /** Label for the link on to the About page. Omitted on About itself. */
  cta?: string;
  ctaHref?: string;
}

const { eyebrow, title, body, features, assurances, cta, ctaHref }: Props = Astro.props;
---

{/* The client's list has two tiers that read as one: three features of the
    property, each with a description, and three one-word assurances about the
    investment. They are rendered as two rows rather than six equal cards —
    padding the short ones with invented copy would have been the alternative. */}
<section class="bg-surface-2 py-section-sm lg:py-section">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow={eyebrow} title={title} />
      </div>

      <div class="lg:col-span-7 lg:pt-4">
        <p class="text-lg leading-[1.8] text-ink-soft lg:text-xl" data-reveal>{body}</p>
      </div>
    </div>

    <ul class="mt-16 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-3 lg:mt-20">
      {
        features.map((feature, i) => (
          <li
            class="group flex flex-col bg-surface p-7 transition-colors duration-500 hover:bg-surface-3 sm:p-9 lg:p-11"
            data-reveal
            data-reveal-delay={i * 0.1}
          >
            <Icon
              name={feature.icon as IconName}
              class="h-11 w-11 text-gold-500 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:-translate-y-1"
            />

            <h3 class="mt-8 font-display text-xl leading-snug text-balance text-ink">{feature.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{feature.body}</p>

            <span
              class="mt-auto block h-px w-10 bg-gold-500/40 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:w-20 group-hover:bg-gold-500"
              aria-hidden="true"
              style="margin-top:2.5rem"
            />
          </li>
        ))
      }
    </ul>

    {/* Three words, so they get one line rather than three empty cards. */}
    {
      assurances && (
        <ul class="mt-10 grid gap-x-10 gap-y-6 border-t border-line pt-10 sm:grid-cols-3 lg:mt-14 lg:pt-12">
          {assurances.map((assurance, i) => (
            <li class="flex items-center gap-4" data-reveal data-reveal-delay={i * 0.08}>
              <Icon name={assurance.icon as IconName} class="h-7 w-7 shrink-0 text-gold-500" />
              <span class="font-display text-base leading-snug text-ink lg:text-lg">{assurance.title}</span>
            </li>
          ))}
        </ul>
      )
    }

    {
      cta && ctaHref && (
        <div class="mt-14 lg:mt-16" data-reveal>
          <Button href={ctaHref} variant="outline">
            {cta}
          </Button>
        </div>
      )
    }
  </div>
</section>
