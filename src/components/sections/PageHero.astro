---
interface Props {
  eyebrow?: string;
  title: string;
  image?: string;
  /** Short lead paragraph under the rule. */
  intro?: string;
}

const { eyebrow, title, image = '/images/hero2-1920.webp', intro } = Astro.props;
---

{/* Inner-page banner. It stays image-backed on purpose: the fixed header
    starts as white type, and needs something to sit on until it turns solid. */}
<section class="relative flex min-h-[24rem] items-end overflow-hidden bg-deep pt-32 pb-16 lg:min-h-[32rem] lg:pt-40 lg:pb-24">
  <img
    src={image}
    alt=""
    width="1920"
    height="1080"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 h-[112%] w-full object-cover"
    data-parallax="-0.08"
  />

  <div class="absolute inset-0 bg-gradient-to-t from-deep/80 via-deep/45 to-deep/55" aria-hidden="true"></div>

  <div class="relative container-page">
    {eyebrow && <p class="eyebrow text-gold-300" data-reveal>{eyebrow}</p>}

    <h1 class="display-title mt-5 max-w-4xl text-white lg:text-6xl xl:text-7xl" data-split style="opacity:0">
      {title}
    </h1>

    <span class="mt-8 block h-px w-16 bg-gold-400" data-reveal data-reveal-delay="0.15" aria-hidden="true"></span>

    {
      intro && (
        <p class="mt-8 max-w-2xl text-[0.98rem] leading-[1.85] text-white/80" data-reveal data-reveal-delay="0.22">
          {intro}
        </p>
      )
    }
  </div>
</section>
