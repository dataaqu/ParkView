---
import { MAP_HREF } from '../../config/site';

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  /** What surrounds the site — rendered as a list under the paragraph. */
  points?: string[];
  /** Label for the "open in Google Maps" link; omitted, no link. */
  mapLink?: string;
}

const { eyebrow, title, body, points, mapLink }: Props = Astro.props;
---

{/* The one dark band on the page. It carries a single idea — where the houses
    are and what that neighbourhood is — so it is deliberately sparse: heading
    on the left, one paragraph on the right, and a great deal of air between
    them. The 5/7 split matches the light sections above it. */}
<section class="relative overflow-hidden bg-deep py-section-sm text-white lg:py-section" data-district>
  {/* A single wash of warmth on the dark ground, off to one side. */}
  <span
    class="pointer-events-none absolute -top-1/4 -right-1/4 hidden aspect-square w-[42rem] rounded-full bg-[radial-gradient(circle,color-mix(in_oklab,var(--color-gold-500)_14%,transparent),transparent_62%)] lg:block"
    aria-hidden="true"></span>

  <div class="relative container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        {eyebrow && <p class="eyebrow text-gold-300" data-reveal>{eyebrow}</p>}

        <h2 class="display-title mt-4 text-balance text-white lg:text-5xl xl:text-[3.5rem]" data-split style="opacity:0">
          {title}
        </h2>

        <span class="mt-8 block h-px w-16 bg-gold-400" data-reveal data-reveal-delay="0.15" aria-hidden="true"></span>
      </div>

      <div class="lg:col-span-7 lg:pt-4">
        <p class="text-lg leading-[1.8] text-white/70 lg:text-xl" data-reveal data-reveal-delay="0.1">{body}</p>

        {
          points && points.length > 0 && (
            <ul class="mt-10 divide-y divide-white/15 border-y border-white/15">
              {points.map((point, i) => (
                <li class="flex gap-5 py-5 text-[0.98rem] leading-relaxed text-white/85" data-reveal data-reveal-delay={0.12 + i * 0.06}>
                  <span class="font-display text-gold-300" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )
        }

        {
          mapLink && (
            <a
              href={MAP_HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-10 inline-flex items-center gap-2 text-[0.78rem] font-medium tracking-[0.12em] text-gold-300 transition-colors duration-300 hover:text-white"
              data-reveal
            >
              {mapLink}
              <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
                <path d="M4 2h6v6M10 2 2.5 9.5" />
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
