---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  /** Title-block line printed under the drawing, in the drawing's own voice. */
  caption: string;
  image?: string;
}

const { eyebrow, title, body, caption, image = '/images/facade-plan-1024.webp' }: Props = Astro.props;
---

{/* The architect's sectional drawing is the one piece on the site that shows
    the whole building at once, so it is given a band of its own and printed
    large on a plate rather than dropped into a grid of thumbnails. The wipe
    below is the point of the section: the drawing draws itself in, left to
    right, the way it was made. Nothing annotates it — the drawing labels its
    own units and its own garage, and anything further would be invented. */}
<section class="relative overflow-hidden bg-surface py-section-sm lg:py-section" data-plan>
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}

        <h2 class="display-title mt-4 text-balance text-ink lg:text-5xl xl:text-[3.5rem]" data-split style="opacity:0">
          {title}
        </h2>

        <span class="mt-8 block h-px w-16 bg-gold-500" data-reveal data-reveal-delay="0.15" aria-hidden="true"></span>
      </div>

      <div class="lg:col-span-7 lg:pt-4">
        <p class="text-lg leading-[1.8] text-ink-soft lg:text-xl" data-reveal data-reveal-delay="0.1">{body}</p>
      </div>
    </div>

    <figure class="mx-auto mt-16 max-w-[68rem] lg:mt-24">
      {/* The plate. Its ground is the warm surface so the drawing's paper
          reads as paper rather than as a photograph pasted onto white. */}
      <div class="relative overflow-hidden border border-line bg-surface-3 p-3 lg:p-5" data-plan-frame>
        <img
          src={image}
          alt={caption}
          width="1024"
          height="576"
          loading="lazy"
          decoding="async"
          class="block w-full"
          data-plan-image
          style="clip-path:inset(0 100% 0 0)"
        />

        {/* The edge the wipe leaves behind, riding along with it. */}
        <span
          class="pointer-events-none absolute inset-y-3 w-px bg-gold-500 opacity-0 lg:inset-y-5"
          aria-hidden="true"
          data-plan-scan></span>
      </div>

      <figcaption
        class="mt-5 flex flex-col gap-2 text-[0.7rem] tracking-[0.18em] text-muted uppercase sm:flex-row sm:items-baseline sm:justify-between"
        data-reveal
        data-reveal-delay="0.1"
      >
        <span>{caption}</span>
        <span class="text-gold-600" aria-hidden="true">PARK VIEW</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const frame = document.querySelector<HTMLElement>('[data-plan-frame]');
  const image = frame?.querySelector<HTMLElement>('[data-plan-image]');
  const scan = frame?.querySelector<HTMLElement>('[data-plan-scan]');

  if (image) {
    /* The clip is inline in the markup so the drawing is never briefly whole
       before the wipe starts. Anything that stops the animation running —
       reduced motion included — has to hand it back. */
    if (!frame || !scan || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.set(image, { clipPath: 'inset(0 0% 0 0)' });
    } else {
      const timeline = gsap.timeline({
        scrollTrigger: { trigger: frame, start: 'top 78%', once: true },
      });

      timeline
        .to(image, { clipPath: 'inset(0 0% 0 0)', duration: 1.6, ease: 'expo.inOut' })
        .fromTo(scan, { left: '0%', opacity: 1 }, { left: '100%', duration: 1.6, ease: 'expo.inOut' }, 0)
        .to(scan, { opacity: 0, duration: 0.35 }, '-=0.25');
    }
  }
</script>
