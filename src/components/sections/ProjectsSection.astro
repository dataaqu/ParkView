---
import SectionHeading from '../SectionHeading.astro';
import { t } from '../../content';
import type { Locale } from '../../i18n/config';
import { localizedPath } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const copy = t(locale);

/* Galaxy Enterprises' projects. One today — PARK VIEW — so the card runs the
   full width; a second project is another entry in PROJECTS and the grid
   below splits into two columns on its own. */
const PROJECTS = [
  {
    name: 'PARK VIEW',
    logo: '/images/logo-dark.png',
    image: '/images/hero2-1920.webp',
    srcset: '/images/hero2-1280.webp 1280w, /images/hero2-1920.webp 1920w',
    location: copy.home.location.title,
    summary: copy.project.overview.title,
    href: localizedPath(locale, 'project'),
  },
];
---

<section class="bg-surface py-section-sm lg:py-section">
  <div class="container-page">
    <SectionHeading eyebrow={copy.home.projects.eyebrow} title={copy.home.projects.title} />

    <ul class:list={['mt-14 grid gap-8 lg:mt-20', PROJECTS.length > 1 && 'lg:grid-cols-2']}>
      {
        PROJECTS.map((project) => (
          <li data-reveal>
            <a
              href={project.href}
              class="group grid overflow-hidden border border-line bg-surface-2 lg:grid-cols-12"
            >
              <div class="relative aspect-[16/10] overflow-hidden lg:col-span-7 lg:aspect-auto lg:min-h-[28rem]">
                <img
                  src={project.image}
                  srcset={project.srcset}
                  sizes="(min-width: 1024px) 58vw, 100vw"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1.2s] ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                />
              </div>

              <div class="flex flex-col justify-center p-8 sm:p-10 lg:col-span-5 lg:p-14">
                <img src={project.logo} alt={project.name} width="114" height="75" class="h-16 w-auto self-start lg:h-20" />

                <h3 class="mt-8 font-display text-3xl leading-snug text-balance text-ink lg:text-4xl">{project.summary}</h3>

                <p class="mt-4 text-[0.98rem] text-muted">{project.location}</p>

                {/* Looks like the outline button, but a span: the whole card is
                    already the link, and a link inside a link is invalid. */}
                <span class="relative mt-10 inline-flex items-center gap-3 self-start overflow-hidden border border-gold-500 px-8 py-4 text-[0.78rem] font-medium tracking-[0.16em] text-gold-600 transition-colors duration-500 group-hover:text-white">
                  <span
                    class="absolute inset-0 origin-bottom scale-y-0 bg-gold-700 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-y-100"
                    aria-hidden="true"
                  />
                  <span class="relative">{copy.home.hero.explore}</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
