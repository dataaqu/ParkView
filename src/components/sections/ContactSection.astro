---
import MapEmbed from '../MapEmbed.astro';
import SocialLinks from '../SocialLinks.astro';
import { t } from '../../content';
import { ADDRESS, SITE } from '../../config/site';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);

const labels: Record<Locale, { phone: string; email: string; address: string; social: string }> = {
  ka: { phone: 'ტელეფონი', email: 'ელფოსტა', address: 'მისამართი', social: 'სოციალური ქსელები' },
  en: { phone: 'Phone', email: 'Email', address: 'Address', social: 'Social' },
  ru: { phone: 'Телефон', email: 'Эл. почта', address: 'Адрес', social: 'Соцсети' },
};

const label = labels[locale];
---

{/* No form. With it gone the page has one job — hand over the two ways to
    reach the company and show where the building is — so the details column
    stays narrow and the map takes the width the form used to. */}
<section class="bg-surface py-section-sm lg:py-section">
  <div class="container-page grid gap-16 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      {/* The lead paragraph the client dropped on 19 Aug stood here. It was
          written for a form — "write to us about yourself" — and with the form
          gone one large word does the same work: it names the column and gives
          the details something to hang under. `contact.intro` is still in the
          three content files, unused, because nothing here is under version
          control and the copy is the client's. */}
      <h2 class="text-5xl text-ink lg:text-6xl xl:text-7xl" data-split style="opacity:0">
        {copy.nav.contact}
      </h2>

      <span class="mt-8 block h-px w-16 bg-gold-500" data-reveal data-reveal-delay="0.15" aria-hidden="true"></span>

      {/* Phone and email are set at heading scale, not list scale: they are
          the whole point of the page and there is nothing left to compete
          with them. */}
      <dl class="mt-12 divide-y divide-line border-y border-line">
        <div class="py-7" data-reveal>
          <dt class="eyebrow">{label.phone}</dt>
          <dd class="mt-3">
            <a
              href={`tel:${SITE.phoneHref}`}
              class="font-display text-2xl text-ink transition-colors duration-300 hover:text-gold-600 lg:text-[1.75rem]"
            >
              {SITE.phone}
            </a>
          </dd>
        </div>

        <div class="py-7" data-reveal data-reveal-delay="0.08">
          <dt class="eyebrow">{label.email}</dt>
          <dd class="mt-3">
            <a
              href={`mailto:${SITE.email}`}
              class="font-display text-2xl break-all text-ink transition-colors duration-300 hover:text-gold-600 lg:text-[1.75rem]"
            >
              {SITE.email}
            </a>
          </dd>
        </div>

        <div class="py-7" data-reveal data-reveal-delay="0.16">
          <dt class="eyebrow">{label.address}</dt>
          <dd class="mt-3 text-[0.98rem] text-ink">{ADDRESS[locale]}</dd>
        </div>
      </dl>

      <div class="mt-12" data-reveal data-reveal-delay="0.2">
        <p class="eyebrow">{label.social}</p>
        <SocialLinks class="mt-5" />
      </div>
    </div>

    <div class="lg:col-span-7" data-reveal data-reveal-delay="0.1">
      <MapEmbed locale={locale} />
    </div>
  </div>
</section>
