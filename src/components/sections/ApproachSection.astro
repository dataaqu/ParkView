---
import Icon, { type IconName } from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

interface Item {
  icon: string;
  title: string;
  body: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  items: Item[];
}

const { eyebrow, title, items }: Props = Astro.props;
---

{/* "Our approach" on the site map — quality, privacy, architecture. Heading on
    the left, the three principles as a numbered list on the right, so it reads
    as a statement of method rather than a third card grid on the page. */}
<section class="bg-surface py-section-sm lg:py-section">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-20">
    <div class="lg:col-span-5">
      <SectionHeading eyebrow={eyebrow} title={title} />
    </div>

    <ol class="divide-y divide-line border-y border-line lg:col-span-7">
      {
        items.map((item, i) => (
          <li class="grid grid-cols-[auto_1fr] items-start gap-x-6 py-8 sm:gap-x-10 lg:py-10" data-reveal data-reveal-delay={i * 0.08}>
            <Icon name={item.icon as IconName} class="mt-1 h-9 w-9 text-gold-500 lg:h-10 lg:w-10" />
            <div>
              <h3 class="font-display text-2xl leading-snug text-ink lg:text-[1.75rem]">{item.title}</h3>
              <p class="mt-3 text-[0.98rem] leading-[1.8] text-ink-soft">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
