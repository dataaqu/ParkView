---
import ContactForm from '../ContactForm.astro';
import { t } from '../../content';
import { SITE } from '../../config/site';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale }: Props = Astro.props;
const contact = t(locale).contact;
---

{/* The inquiry form on the homepage too (client, 14 Sep), so a visitor can
    write straight from the first page. Same form and endpoint as the contact
    page; this band just adds the phone and email beside it. */}
<section class="bg-surface-2 py-section-sm lg:py-section">
  <div class="container-page grid gap-14 lg:grid-cols-12 lg:gap-20">
    <div class="min-w-0 lg:col-span-5">
      {/* Own heading size: "დაგვიკავშირდით" is one long word, and at the
          shared section size it ran out of this narrow column and was clipped. */}
      <p class="eyebrow" data-reveal>{contact.actions.title}</p>
      <h2 class="mt-4 font-display text-[1.85rem] leading-[1.16] text-ink min-[400px]:text-4xl sm:text-5xl lg:text-4xl xl:text-5xl" data-reveal>
        {contact.form.title}
      </h2>
      <span class="mt-7 block h-px w-16 bg-gold-500" aria-hidden="true"></span>

      <p class="mt-8 max-w-md text-[0.98rem] leading-[1.85] text-ink-soft" data-reveal data-reveal-delay="0.1">
        {contact.intro}
      </p>

      <ul class="mt-10 space-y-3 text-ink" data-reveal data-reveal-delay="0.15">
        <li>
          <a href={`tel:${SITE.phoneHref}`} class="font-display text-2xl transition-colors duration-300 hover:text-gold-600">
            {SITE.phone}
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="text-[0.98rem] text-muted transition-colors duration-300 hover:text-gold-600">
            {SITE.email}
          </a>
        </li>
      </ul>
    </div>

    <div class="border border-line bg-surface p-7 sm:p-10 lg:col-span-7 lg:p-12" data-reveal data-reveal-delay="0.1">
      <ContactForm locale={locale} />
    </div>
  </div>
</section>
