---
import SectionHeading from '../SectionHeading.astro';

interface Fact {
  value: string;
  label: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  facts: Fact[];
}

const { eyebrow, title, body, facts }: Props = Astro.props;
---

{/* The project in one screen: what it is, then the three numbers that define
    it. The numbers are all stated elsewhere in the client's copy — four
    townhouses, five levels, a garage for two cars — nothing here is new. */}
<section class="bg-surface py-section-sm lg:py-section">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <SectionHeading eyebrow={eyebrow} title={title} />
      </div>

      <div class="lg:col-span-7 lg:pt-4">
        <p class="text-lg leading-[1.8] text-ink-soft lg:text-xl" data-reveal>{body}</p>
      </div>
    </div>

    <dl class="mt-16 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-3 lg:mt-20">
      {
        facts.map((fact, i) => (
          <div class="flex flex-col-reverse bg-surface-2 p-8 lg:p-11" data-reveal data-reveal-delay={i * 0.1}>
            <dt class="mt-3 text-sm tracking-[0.04em] text-muted">{fact.label}</dt>
            <dd class="font-display text-6xl leading-none text-gold-500 lg:text-7xl" data-count={fact.value}>
              {fact.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
