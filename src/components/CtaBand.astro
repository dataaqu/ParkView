---
import Button from './Button.astro';
import { t } from '../content';
import type { Locale } from '../i18n/config';
import { localizedPath } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
---

<section class="relative overflow-hidden py-section-sm lg:py-section">
  <div class="container-page relative text-center">
    <p class="eyebrow text-gold-300" data-reveal>{copy.cta.eyebrow}</p>

    <h2 class="display-title mx-auto mt-5 max-w-3xl text-white lg:text-6xl" data-split style="opacity:0">
      {copy.cta.title}
    </h2>

    <div class="mt-11" data-reveal data-reveal-delay="0.2">
      <Button href={localizedPath(locale, 'contact')} variant="solid">
        {copy.cta.button}
      </Button>
    </div>
  </div>
</section>
