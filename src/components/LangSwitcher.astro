---
import { t } from '../content';
import { LOCALE_META, type Locale } from '../i18n/config';
import { alternates } from '../i18n/utils';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = '' }: Props = Astro.props;

const copy = t(locale);
const options = alternates(Astro.url.pathname);
const current = LOCALE_META[locale];
---

{/* Codes rather than flags: a flag names a country, not a language. */}
<div class:list={['relative', className]} data-lang>
  <button
    type="button"
    data-lang-toggle
    aria-expanded="false"
    aria-haspopup="true"
    aria-label={`${copy.common.language}: ${current.label}`}
    class="lang-toggle flex items-center gap-1.5 px-1 py-2 text-[0.82rem] tracking-[0.1em]"
  >
    <span aria-hidden="true">{current.short}</span>

    <svg
      class="lang-chevron h-2 w-3"
      viewBox="0 0 12 8"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m1 2 5 4 5-4" />
    </svg>
  </button>

  {/* Always a light panel: it floats over both header states, so inheriting
      the header's white-over-hero colour would leave it unreadable. */}
  <ul
    data-lang-menu
    hidden
    class="absolute right-0 top-full z-10 mt-2 min-w-[6.5rem] border border-line bg-surface py-1 shadow-[0_12px_32px_-12px_rgb(23_23_23/0.28)]"
  >
    {
      options.map(({ locale: alt, path }) => (
        <li>
          <a
            href={path}
            hreflang={LOCALE_META[alt].hreflang}
            lang={LOCALE_META[alt].htmlLang}
            aria-current={alt === locale ? 'true' : undefined}
            class:list={[
              'block px-4 py-2 text-[0.82rem] tracking-[0.1em] transition-colors duration-150 ease-out',
              alt === locale ? 'text-gold-600' : 'text-ink-soft hover:bg-surface-2 hover:text-gold-600',
            ]}
          >
            {LOCALE_META[alt].short}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang-toggle {
    font-family: var(--font-display);
    /* Matches the nav links it sits beside; at 400 it read as an afterthought
       next to them. */
    font-weight: 700;
    transition: color 0.15s ease-out;
  }

  .lang-chevron {
    transition: transform 0.25s ease-out;
  }

  [data-lang-toggle][aria-expanded='true'] .lang-chevron {
    transform: rotate(180deg);
  }

  /* Same state-driven colouring as the nav links — see Header.astro. */
  header .lang-toggle {
    color: color-mix(in oklab, #fff 88%, transparent);
  }

  header .lang-toggle:hover {
    color: var(--color-gold-400);
  }

  header.is-solid .lang-toggle,
  header.menu-open .lang-toggle {
    color: var(--color-ink-soft);
  }

  header.is-solid .lang-toggle:hover,
  header.menu-open .lang-toggle:hover {
    color: var(--color-gold-600);
  }

  [data-lang-menu]:not([hidden]) {
    animation: lang-in 0.18s ease-out both;
  }

  @keyframes lang-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-lang-toggle]');
    const menu = root.querySelector<HTMLElement>('[data-lang-menu]');
    if (!toggle || !menu) return;

    let open = false;

    const setOpen = (next: boolean) => {
      open = next;
      menu.hidden = !next;
      toggle.setAttribute('aria-expanded', String(next));
    };

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!open);
    });

    // Anywhere outside closes it, including the other header controls.
    document.addEventListener('click', (event) => {
      if (open && !root.contains(event.target as Node)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && open) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Tabbing past the last option should not leave a menu hanging open.
    root.addEventListener('focusout', () => {
      requestAnimationFrame(() => {
        if (open && !root.contains(document.activeElement)) setOpen(false);
      });
    });
  });
</script>
