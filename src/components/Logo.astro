---
interface Props {
  /**
   * `switch` renders both marks and lets the header state pick one — the
   * gold-on-light mark is too dark over the hero photo, the light one too pale
   * over the solid header. `dark` is for light grounds, `light` for dark ones.
   */
  variant?: 'switch' | 'dark' | 'light';
  class?: string;
}

const { variant = 'dark', class: className = '' }: Props = Astro.props;

/* The site's mark is the developer's — Galaxy Enterprises (client, 14 Sep).
   Both files are cut from the client's dark-ground PNG by
   scripts/company-logo.mjs. The old PARK VIEW marks (logo-dark/-light.png)
   are still in public/images if they are ever wanted back. 767×109. */
const WIDTH = 767;
const HEIGHT = 109;
const alt = 'Galaxy Enterprises LLC';
const LIGHT = '/images/company/galaxy-light.png';
const DARK = '/images/company/galaxy-gold.png';
---

{
  variant === 'switch' ? (
    <span class:list={['logo relative block', className]}>
      {/* The header wraps this in a link that carries its own aria-label,
          so both marks are decorative here. */}
      <img src={LIGHT} alt="" aria-hidden="true" width={WIDTH} height={HEIGHT} class="logo-light h-7 w-auto min-[400px]:h-8 sm:h-9 xl:h-11" />
      <img
        src={DARK}
        alt=""
        aria-hidden="true"
        width={WIDTH}
        height={HEIGHT}
        class="logo-dark absolute top-0 left-0 h-7 w-auto opacity-0 min-[400px]:h-8 sm:h-9 xl:h-11"
      />
    </span>
  ) : (
    <img
      src={variant === 'light' ? LIGHT : DARK}
      alt={alt}
      width={WIDTH}
      height={HEIGHT}
      class:list={['max-w-full', className || 'h-10 w-auto']}
    />
  )
}

<style>
  .logo-light,
  .logo-dark {
    /* Matches the nav links' colour flip, not the slower background fade —
       the two marks swapping at different speeds reads as a glitch. */
    transition: opacity 0.18s ease-out;
  }

  /* Once the header goes solid — or the mobile menu opens over a white
     panel — swap to the gold mark. */
  :global(header.is-solid) .logo-light,
  :global(header.menu-open) .logo-light {
    opacity: 0;
  }

  :global(header.is-solid) .logo-dark,
  :global(header.menu-open) .logo-dark {
    opacity: 1;
  }
</style>
